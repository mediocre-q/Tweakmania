<Window x:Class="Tweak.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Tweak.App.Controls"
        Title="Tweakmania"
        Width="1240" Height="850" MinWidth="1080" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="#101820" Foreground="#EAF2F7"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.InputBindings><KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" /></Window.InputBindings>
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#18232D" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#202D38" />
        <SolidColorBrush x:Key="LineBrush" Color="#30404D" />
        <SolidColorBrush x:Key="MutedBrush" Color="#91A2AF" />
        <SolidColorBrush x:Key="CyanBrush" Color="#39D5D0" />
        <SolidColorBrush x:Key="CoralBrush" Color="#FF7F72" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAF2F7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F3F8FB" />
            <Setter Property="Background" Value="#111B23" />
            <Setter Property="BorderBrush" Value="#344652" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CaretBrush" Value="#39D5D0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#14202A" />
            <Setter Property="Background" Value="#EAF2F7" />
            <Setter Property="BorderBrush" Value="#344652" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EAF2F7" />
            <Setter Property="Background" Value="#253542" />
            <Setter Property="BorderBrush" Value="#3A4D5B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#304554" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.78" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.42" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1E8F92" />
            <Setter Property="BorderBrush" Value="#39D5D0" />
            <Setter Property="Foreground" Value="#07191D" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DCE6EC" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#111B23" />
            <Setter Property="Foreground" Value="#EAF2F7" />
            <Setter Property="BorderBrush" Value="#344652" />
            <Setter Property="RowBackground" Value="#16222C" />
            <Setter Property="AlternatingRowBackground" Value="#1A2731" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#293944" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="ColumnHeaderHeight" Value="31" />
            <Setter Property="RowHeight" Value="33" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#202D38" />
            <Setter Property="Foreground" Value="#A8B8C3" />
            <Setter Property="BorderBrush" Value="#30404D" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#24535A" /><Setter Property="Foreground" Value="White" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#18232D"/><Setter Property="Foreground" Value="#EAF2F7"/>
            <Setter Property="BorderBrush" Value="#30404D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#EAF2F7"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,7"/><Setter Property="MinWidth" Value="210"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#253542"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="8,4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="26,22,26,18" Background="#101820">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Tweakmania" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource CyanBrush}" />
                <Border Background="#18252F" BorderBrush="#30404D" BorderThickness="1" CornerRadius="9" Padding="10,5" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#667782"/><Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Background" Value="#39D5D0"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        </Border>
                        <TextBlock Text="{Binding RunningLabel}" FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
            <StackPanel Grid.Row="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="PROFILE" Style="{StaticResource FieldLabel}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <ComboBox x:Name="ProfileSelector" Grid.Column="1" ItemsSource="{Binding Profiles}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding SelectedProfileId, Mode=TwoWay}" Padding="9,7" />
                    <Button Grid.Column="2" Content="Save" Command="{Binding SaveCommand}" Margin="8,0,0,0" Padding="17,7" Style="{StaticResource AccentButton}" />
                    <Button Grid.Column="3" Content="+ New" Command="{Binding NewProfileCommand}" Margin="7,0,0,0" Padding="12,7" />
                    <Button Grid.Column="4" Content="More ▾" Click="More_Click" Margin="7,0,0,0" Padding="12,7">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <ContextMenu.Resources>
                                    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}" />
                                </ContextMenu.Resources>
                                <MenuItem Header="Duplicate…" Command="{Binding PlacementTarget.DataContext.DuplicateProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Rename…" Command="{Binding PlacementTarget.DataContext.RenameProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Revert to saved" Command="{Binding PlacementTarget.DataContext.RevertProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Delete…" Command="{Binding PlacementTarget.DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="Import profiles…" Command="{Binding PlacementTarget.DataContext.ImportProfilesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Export current profile…" Command="{Binding PlacementTarget.DataContext.ExportProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Steering response" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding PreviewStatus}" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox Content="Live preview" IsChecked="{Binding MonitorEnabled, Mode=TwoWay}" Margin="0,0,11,0" />
                                    <Button Content="Try demo" Command="{Binding DemoCommand}" Padding="12,7" />
                                </StackPanel>
                            </Grid>
                            <Border Background="Transparent">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="1" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsMonitoringActive}" Value="False"><Setter Property="Opacity" Value="0.4" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="INPUT" Grid.Row="0" Grid.Column="0" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                        <controls:SteeringPreview Grid.Row="0" Grid.Column="1" Value="{Binding RawInput}" Height="42" />
                                        <TextBlock Text="OUTPUT" Grid.Row="1" Grid.Column="0" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                        <controls:SteeringPreview Grid.Row="1" Grid.Column="1" Value="{Binding OutputValue}" Height="42" />
                                    </Grid>
                                    <Grid Margin="90,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="−100%  LEFT" Foreground="{StaticResource CoralBrush}" FontSize="10" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="RIGHT  +100%" Foreground="{StaticResource CyanBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Response curve" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Drag a point to tune the selected side." Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox Content="Mirror left/right" IsChecked="{Binding Mirror}" Margin="0,0,14,0" />
                                    <TextBlock Text="Editing:" Style="{StaticResource MutedText}" Margin="0,0,6,0" />
                                    <ComboBox ItemsSource="{Binding CurveSides}" SelectedItem="{Binding EditingSide, Mode=TwoWay}" Width="92" Padding="6,3">
                                        <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers><DataTrigger Binding="{Binding Mirror}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></ComboBox.Style>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <controls:CurveEditor Height="220" Profile="{Binding ActiveProfile}" InputValue="{Binding RawInput}" OutputValue="{Binding OutputValue}" EditLeftCurve="{Binding EditLeftCurve}" ShowLiveMarker="{Binding IsMonitoringActive}" CurveEdited="CurveEditor_CurveEdited" />
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Curve points" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="＋ Add point" Command="{Binding AddPointCommand}" Padding="10,6" Margin="0,0,7,0" />
                                <Button Grid.Column="2" Content="Remove" Command="{Binding RemovePointCommand}" Padding="10,6" />
                            </Grid>
                            <DataGrid x:Name="CurveGrid" ItemsSource="{Binding CurvePoints}" SelectedItem="{Binding SelectedPoint, Mode=TwoWay}" MaxHeight="100" Margin="0,6,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="INPUT %" Binding="{Binding InputPercent, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                    <DataGridTextColumn Header="OUTPUT %" Binding="{Binding OutputPercent, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="Endpoints stay fixed. Values must increase from 0% to 100%." Style="{StaticResource MutedText}" FontSize="10" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Connection" FontSize="17" FontWeight="SemiBold"/><Button Grid.Column="1" Content="Setup…" Click="Setup_Click" Padding="9,5" /></Grid>
                            <TextBlock Text="INPUT DEVICE" Style="{StaticResource FieldLabel}" />
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding DeviceChoices}" SelectedItem="{Binding SelectedDevice}" IsEnabled="{Binding IsIdle}">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="#14202A" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="INPUT AXIS" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding InputAxes}" SelectedItem="{Binding SelectedInputAxis}" IsEnabled="{Binding IsIdle}">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" Foreground="#14202A" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding OutputStatus}" Foreground="{Binding ProxyStatusColor}" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Calibration" FontSize="17" FontWeight="SemiBold" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,6"><TextBlock Text="MINIMUM %" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding MinimumText, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" /></StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,6"><TextBlock Text="CENTER %" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding CenterText, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" /></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,6"><TextBlock Text="MAXIMUM %" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding MaximumText, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" /></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,6"><TextBlock Text="DEADZONE %" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding DeadzoneText, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" /></StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0"><TextBlock Text="SATURATION %" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SaturationText, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" /></StackPanel>
                                <Button Grid.Row="2" Grid.Column="2" Content="Center now" Command="{Binding CenterCommand}" VerticalAlignment="Bottom" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Tuning" FontSize="17" FontWeight="SemiBold" />
                            <CheckBox Content="Bypass curve" IsChecked="{Binding Bypass}" Margin="0,7,0,6" />
                            <CheckBox Content="Invert steering" IsChecked="{Binding Invert}" />
                            <Button Content="Reset settings" Command="{Binding ResetCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="9,5" />
                        </StackPanel>
                    </Border>

                    <Border Background="#16242C" BorderBrush="#275157" BorderThickness="1" CornerRadius="12" Padding="10">
                        <StackPanel>
                            <TextBlock Text="PROXY AND ROUTING STATUS" Foreground="{StaticResource CyanBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="{Binding OutputStatus}" Foreground="{Binding ProxyStatusColor}" FontWeight="SemiBold" Margin="0,3,0,2" TextWrapping="Wrap" FontSize="12" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding ValidationMessage}" Foreground="{StaticResource CoralBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7" />
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" FontSize="11" />
                <Button Grid.Column="1" Content="{Binding StartStopLabel}" Command="{Binding StartStopCommand}" Style="{StaticResource AccentButton}" MinWidth="128" Margin="0" />
            </Grid>
        </Grid>
    </Grid>
</Window>
