<Window x:Class="Tweak.App.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connection setup" Width="520" SizeToContent="Height" MinWidth="480" MinHeight="300"
        WindowStartupLocation="CenterOwner" Background="#101820" Foreground="#EAF2F7"
        FontFamily="Segoe UI" FontSize="13" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EAF2F7"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="TextBox"><Setter Property="Foreground" Value="#F3F8FB"/><Setter Property="Background" Value="#111B23"/><Setter Property="BorderBrush" Value="#344652"/><Setter Property="Padding" Value="8,6"/><Setter Property="CaretBrush" Value="#39D5D0"/></Style>
        <Style TargetType="Button"><Setter Property="Foreground" Value="#EAF2F7"/><Setter Property="Background" Value="#253542"/><Setter Property="BorderBrush" Value="#3A4D5B"/><Setter Property="Padding" Value="11,7"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DCE6EC"/></Style>
    </Window.Resources>
    <Border Background="#18232D" BorderBrush="#30404D" BorderThickness="1" CornerRadius="14" Padding="18" Margin="18">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Connection setup" FontSize="19" FontWeight="SemiBold" Foreground="#39D5D0" Margin="0,0,0,13"/>
            <CheckBox Grid.Row="1" Content="Apply in game" IsChecked="{Binding ApplyInGame}" IsEnabled="{Binding IsIdle}" Margin="0,0,0,12"/>
            <TextBlock Grid.Row="2" Text="GAME EXECUTABLE" Foreground="#91A2AF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Text="{Binding GameExecutablePath, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding IsIdle}" ToolTip="{Binding GameExecutablePath}"/>
                <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseGameCommand}" IsEnabled="{Binding IsIdle}" Margin="7,0,0,0"/>
            </Grid>
            <StackPanel Grid.Row="4" Margin="0,11,0,0">
                <TextBlock Text="Install beside the game executable. Changes apply when the game loads the proxy." Foreground="#91A2AF" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding OutputStatus}" Foreground="{Binding ProxyStatusColor}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Install proxy" Command="{Binding InstallProxyCommand}" Margin="0,0,8,0"/>
                    <Button Content="Remove proxy" Command="{Binding RemoveProxyCommand}" Margin="0,0,8,0"/>
                    <Button Content="Refresh devices" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsIdle}"/>
                </StackPanel>
                <TextBlock Text="{Binding ProxyActionError}" Foreground="#FF7F72" TextWrapping="Wrap" Margin="0,10,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Style.Triggers><DataTrigger Binding="{Binding ProxyActionError}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</Window>
